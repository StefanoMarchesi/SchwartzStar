+// GGML_METAL_FA_KV_F16=0 restores the behaviour before commit 5f36145: the banded op and every mixed K/V pair
+// dequantize inline, so the F16 K/V copy (2 x n_kv x n_head_kv x head_size x 2 bytes, 1 GiB at 256K) stays out
+// of the compute buffer. Read once: the buffer reservation (ggml_backend_metal_buffer_type_get_alloc_size) and
+// the graph encoding both call use_kv_f16(), and they must agree.
+static bool ggml_metal_op_flash_attn_ext_kv_f16_enabled() {
+    static const bool enabled = []() {
+        const char * env = std::getenv("GGML_METAL_FA_KV_F16");
+        return env == nullptr || env[0] == '\0' || std::atoi(env) != 0;
+    }();
+
+    return enabled;
+}
