+// the F16 dequant pass has one kernel instantiation per source type, so K and V may differ
+// (a turbo3 V cache with a q4_0 K is the case the outline kernel is used for)
+static bool ggml_metal_op_flash_attn_ext_kv_f16_supported(ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q4_1:
+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q5_1:
+        case GGML_TYPE_Q8_0:
+        case GGML_TYPE_TURBO3_0:
+            return true;
+        default:
+            return false;
+    }
