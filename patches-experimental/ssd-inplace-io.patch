 namespace {
 
+static ggml_backend_buffer_t tensor_buffer(const ggml_tensor * t) {
+    return t->view_src ? t->view_src->buffer : t->buffer;
+}
+
+// a buffer that the CPU may read and write through the tensor data pointer. Metal reports is_host = false for
+// every buffer type, but its default allocation on Apple Silicon is shared (unified) memory.
+static bool buffer_cpu_visible(ggml_backend_buffer_t buffer) {
+    if (buffer == nullptr) {
+        return false;
+    }
+    if (ggml_backend_buffer_is_host(buffer)) {
+        return true;
+    }
+#if defined(__APPLE__) && defined(GGML_USE_METAL)
+    return ggml_backend_metal_buffer_is_shared(buffer);
+#else
+    return false;
+#endif
+}
