+// TurboQuant3 (GGML_TYPE_TURBO3_0): one 128-value block per WHT group.
+// Same centroids and midpoints as turbo3 in ggml-turbo-quant.c (CPU).
+// Values stay in the rotated domain: the inverse WHT is a separate op.
+constant float turbo3_centroids[8] = {
+    -0.190207f, -0.118786f, -0.066822f, -0.021663f,
+     0.021663f,  0.066822f,  0.118786f,  0.190207f
+};
+constant float turbo3_mids[7] = {
+    -0.154496f, -0.092804f, -0.044243f, 0.0f, 0.044243f, 0.092804f, 0.154496f
+};
+
+// il in [0, 8): 16 values, elements il*16 .. il*16+15 of the block
+template <typename type4x4>
+void dequantize_turbo3_0(device const block_turbo3_0 * xb, short il, thread type4x4 & reg) {
+    const float norm = (float) xb->norm;
+
+    float4x4 reg_f;
+    for (short k = 0; k < 16; ++k) {
+        const short j = il*16 + k;
+        const short idx = ((xb->qs[j/4] >> ((j%4)*2)) & 3) | (((xb->signs[j/8] >> (j%8)) & 1) << 2);
+        reg_f[k/4][k%4] = turbo3_centroids[idx] * norm;
+    }
+
+    reg = (type4x4) reg_f;
+}
+
+// il in [0, 32): 4 values, elements il*4 .. il*4+3 of the block
+template <typename type4>
+void dequantize_turbo3_0_t4(device const block_turbo3_0 * xb, short il, thread type4 & reg) {
+    const float norm = (float) xb->norm;
+
+    for (short k = 0; k < 4; ++k) {
+        const short j = il*4 + k;
+        const short idx = ((xb->qs[j/4] >> ((j%4)*2)) & 3) | (((xb->signs[j/8] >> (j%8)) & 1) << 2);
+        reg[k] = turbo3_centroids[idx] * norm;
+    }
+}
