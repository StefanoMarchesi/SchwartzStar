+template<typename TI>
+kernel void kernel_set_rows_turbo3(
+        constant ggml_metal_kargs_set_rows & args,
+        device const  void * src0,
+        device const  void * src1,
+        device       float * dst,
+        uint3                tgpig[[threadgroup_position_in_grid]],
+        uint                 tiitg[[thread_index_in_threadgroup]],
+        uint3                tptg [[threads_per_threadgroup]]) {
+    const int32_t i03 = tgpig.z;
+    const int32_t i02 = tgpig.y;
+
+    const int32_t i12 = i03%args.ne12;
+    const int32_t i11 = i02%args.ne11;
+
+    const int32_t i01 = tgpig.x*tptg.y + tiitg/tptg.x;
+    if (i01 >= args.ne01) {
+        return;
+    }
+
+    const int32_t i10 = i01;
+    const TI      i1  = ((const device TI *) ((const device char *) src1 + i10*args.nb10 + i11*args.nb11 + i12*args.nb12))[0];
+
+          device block_turbo3_0 * dst_row = (      device block_turbo3_0 *) ((      device char *) dst  +  i1*args.nb1  + i02*args.nb2  + i03*args.nb3);
+    const device float          * src_row = (const device float          *) ((const device char *) src0 + i01*args.nb01 + i02*args.nb02 + i03*args.nb03);
+
+    // args.nk0 counts 128-value groups: one block per group
+    for (int32_t ind = tiitg%tptg.x; ind < args.nk0; ind += tptg.x) {
+        quantize_turbo3_0(src_row + QK_TURBO3*ind, dst_row[ind]);
+    }
+}
+
+typedef decltype(kernel_set_rows_turbo3<int64_t>) set_rows_turbo3_t;
+
+template [[host_name("kernel_set_rows_f32_i64_turbo3")]] kernel set_rows_turbo3_t kernel_set_rows_turbo3<int64_t>;
+template [[host_name("kernel_set_rows_f32_i32_turbo3")]] kernel set_rows_turbo3_t kernel_set_rows_turbo3<int32_t>;
+
+// WHT over 128-value groups: direction 0 = forward (s1, WHT, s2),
+// direction 1 = inverse (s2, WHT, s1). One thread per group. Matches
+// ggml_compute_forward_turbo_wht (no InnerQ scale input).
+kernel void kernel_turbo_wht(
+        constant ggml_metal_kargs_turbo_wht & args [[buffer(0)]],
+        device const float * src [[buffer(1)]],
+        device       float * dst [[buffer(2)]],
+        uint tgpig [[threadgroup_position_in_grid]],
+        uint tiitg [[thread_index_in_threadgroup]],
+        uint ntg   [[threads_per_threadgroup]]) {
+    const int64_t group_idx = (int64_t) tgpig*ntg + tiitg;
+    const int64_t n_groups  = args.n_elements/QK_TURBO3_GROUP;
+    if (group_idx >= n_groups) {
+        return;
+    }
+
+    device const float * in  = src + group_idx*QK_TURBO3_GROUP;
+    device       float * out = dst + group_idx*QK_TURBO3_GROUP;
+
+    const bool inverse = args.direction == 1;
+
+    float x[128];
+    for (short i = 0; i < 128; ++i) {
+        x[i] = in[i] * (inverse ? turbo3_wht_s2[i] : turbo3_wht_s1[i]);
+    }
+    turbo3_fwht_128(x);
+
+    const float inv_sqrt = 0.08838834764831845f;
+    for (short i = 0; i < 128; ++i) {
+        out[i] = x[i] * inv_sqrt * (inverse ? turbo3_wht_s1[i] : turbo3_wht_s2[i]);
+    }
+}
