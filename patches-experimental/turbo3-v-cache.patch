+// TurboQuant 3-bit (PolarQuant, WHT rotation, no QJL)
+// One block = one 128-value rotation group. The 3-bit index is split:
+// lower 2 bits in qs[], upper 1 bit in signs[].
+#define QK_TURBO3 128
