diff --git a/ggml/src/ggml-metal/kernels/dequantize.h b/ggml/src/ggml-metal/kernels/dequantize.h
index e9d6585..144a201 100644
--- a/ggml/src/ggml-metal/kernels/dequantize.h
+++ b/ggml/src/ggml-metal/kernels/dequantize.h
@@ -72,14 +72,34 @@ void dequantize_turbo3_0(device const block_turbo3_0 * xb, short il, thread type
 }
 
 // il in [0, 32): 4 values, elements il*4 .. il*4+3 of the block
+// with a single query the centroid index is data dependent and diverges per lane, and a gather from the constant
+// array serializes there, so the 8 centroids are selected branchlessly from immediates instead
+// the centroids are symmetric: the 2 low bits index four magnitudes from the largest down, and the sign bit picks
+// +mag[3 - code] or -mag[code], so one 4-way mux and one sign select suffice
+static inline float turbo3_centroid_select(int code, bool sign) {
+    const int t = sign ? 3 - code : code;
+
+    const bool b0 = (t & 1) != 0;
+    const bool b1 = (t & 2) != 0;
+
+    const float m01 = select(0.190207f, 0.118786f, b0);
+    const float m23 = select(0.066822f, 0.021663f, b0);
+    const float m   = select(m01, m23, b1);
+
+    return sign ? m : -m;
+}
+
 template <typename type4>
 void dequantize_turbo3_0_t4(device const block_turbo3_0 * xb, short il, thread type4 & reg) {
     const float norm = (float) xb->norm;
 
+    const uint8_t qs = xb->qs[il];
+    const uint8_t si = xb->signs[il/2];
+
     for (short k = 0; k < 4; ++k) {
-        const short j = il*4 + k;
-        const short idx = ((xb->qs[j/4] >> ((j%4)*2)) & 3) | (((xb->signs[j/8] >> (j%8)) & 1) << 2);
-        reg[k] = turbo3_centroids[idx] * norm;
+        const int  code = (qs >> (2*k)) & 3;
+        const bool sign = ((si >> ((il%2)*4 + k)) & 1) != 0;
+        reg[k] = turbo3_centroid_select(code, sign) * norm;
     }
 }
 
