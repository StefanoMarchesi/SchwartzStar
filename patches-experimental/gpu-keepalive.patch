     // wait for any backend operations to finish
     if (ctx->cmd_buf_last) {
         [ctx->cmd_buf_last waitUntilCompleted];
         ctx->cmd_buf_last = nil;
+        // count the hold time from the end of the work, not only from its submission
+        ggml_metal_keepalive_touch(ggml_metal_device_get_obj(ctx->dev));
     }
 
     // check status of all command buffers
@@ -481,6 +605,8 @@ enum ggml_status ggml_metal_graph_compute(ggml_metal_t ctx, struct ggml_cgraph *
         return GGML_STATUS_SUCCESS;
     }
 
+    ggml_metal_keepalive_touch(ggml_metal_device_get_obj(ctx->dev));
+
     // number of nodes encoded by the main thread (empirically determined)
