-                // turbo3 V: no kernel, the CPU runs the attention and its inverse WHT
-                if (op->src[2]->type == GGML_TYPE_TURBO3_0) {
+                // turbo3 V: the banded half8x8 and vec kernels dequantize it inline, for the dense K = q4_0
+                // pair at head size 128 only; the inverse WHT is a separate op on the output
+                const bool turbo3_v = op->src[2]->type == GGML_TYPE_TURBO3_0;
+                if (turbo3_v && !ggml_metal_fa_turbo3_v_banded_ok(op)) {
                     return false;
                 }
 
@@ -1891,7 +1903,7 @@ bool ggml_metal_device_supports_op(ggml_metal_device_t dev, const struct ggml_te
                 if (op->src[0]->ne[1] >= 65536 || op->src[2]->ne[1] != op->src[1]->ne[1]) {
