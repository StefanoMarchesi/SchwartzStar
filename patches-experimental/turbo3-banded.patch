+// turbo3 V in banded flash attention: same pair as the dense path (K = q4_0, V = turbo3, head size 128),
+// no K/V row lists, and the cell positions of src[7]/src[8] are rejected by the banded case below.
+// The banded half8x8 and vec kernels dequantize K and V inline (NL_TURBO3 / NL_TURBO3_VEC), so the
+// 50-byte turbo3 block is read in place; the inverse WHT runs as a separate op on the output.
+static bool ggml_metal_fa_turbo3_v_banded_ok(const struct ggml_tensor * op) {
+    return op->src[1]->type == GGML_TYPE_Q4_0 &&
+        op->src[0]->ne[0] == 128 && op->src[1]->ne[0] == 128 && op->src[2]->ne[0] == 128 &&
+        op->src[5] == NULL && op->src[7] == NULL && op->src[8] == NULL;
+}
