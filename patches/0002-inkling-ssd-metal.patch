diff --git a/src/llama-expert-io.h b/src/llama-expert-io.h
new file mode 100644
index 0000000..2c052ad
--- /dev/null
+++ b/src/llama-expert-io.h
@@ -0,0 +1,92 @@
+#pragma once
+
+#include "ggml.h"
+
+#include <cerrno>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#if defined(__APPLE__)
+#include <fcntl.h>
+#include <unistd.h>
+#endif
+
+inline bool llama_expert_stream_enabled() {
+    const char * mode = std::getenv("LLAMA_INKLING_SSD");
+    return mode && std::strcmp(mode, "1") == 0;
+}
+
+class llama_expert_file {
+public:
+    explicit llama_expert_file(int original_fd) {
+#if defined(__APPLE__)
+        fd = fcntl(original_fd, F_DUPFD_CLOEXEC, 0);
+        if (fd < 0) {
+            throw std::runtime_error(std::string("Inkling SSD: dup: ") + std::strerror(errno));
+        }
+        if (fcntl(fd, F_NOCACHE, 1) < 0) {
+            const int err = errno;
+            close(fd);
+            throw std::runtime_error(std::string("Inkling SSD: F_NOCACHE: ") + std::strerror(err));
+        }
+#else
+        (void) original_fd;
+        throw std::runtime_error("Inkling SSD requires macOS/Metal");
+#endif
+    }
+
+    ~llama_expert_file() {
+#if defined(__APPLE__)
+        close(fd);
+#endif
+    }
+
+    llama_expert_file(const llama_expert_file &) = delete;
+    llama_expert_file & operator=(const llama_expert_file &) = delete;
+
+    // Each caller owns a distinct destination. pread does not mutate the shared file offset.
+    int read(uint8_t * dst, size_t size, size_t offset) const {
+#if defined(__APPLE__)
+        while (size > 0) {
+            const ssize_t n = pread(fd, dst, size, static_cast<off_t>(offset));
+            if (n < 0 && errno == EINTR) {
+                continue;
+            }
+            if (n <= 0) {
+                return n == 0 ? EIO : errno;
+            }
+            dst += n;
+            offset += n;
+            size -= n;
+        }
+        return 0;
+#else
+        (void) dst;
+        (void) size;
+        (void) offset;
+        return ENOTSUP;
+#endif
+    }
+
+private:
+#if defined(__APPLE__)
+    int fd = -1;
+#endif
+};
+
+struct llama_expert_stream {
+    struct source {
+        uint32_t file;
+        size_t offset;
+        const void * mapped_data;
+    };
+
+    std::vector<std::unique_ptr<llama_expert_file>> files;
+    std::unordered_map<const ggml_tensor *, source> weights;
+};
