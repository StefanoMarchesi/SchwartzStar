diff --git a/ggml/include/ggml-metal.h b/ggml/include/ggml-metal.h
index 433838f..a309e81 100644
--- a/ggml/include/ggml-metal.h
+++ b/ggml/include/ggml-metal.h
@@ -44,6 +44,11 @@ GGML_BACKEND_API ggml_backend_t ggml_backend_metal_init(void);
 
 GGML_BACKEND_API bool ggml_backend_is_metal(ggml_backend_t backend);
 
+// true when the buffer is a Metal buffer in shared (unified) memory, which the CPU can write directly.
+// The buffer types report is_host = false on Metal even for shared allocations, so a caller that writes
+// through the tensor data pointer must check this instead.
+GGML_BACKEND_API bool ggml_backend_metal_buffer_is_shared(ggml_backend_buffer_t buffer);
+
 GGML_BACKEND_API void ggml_backend_metal_set_abort_callback(ggml_backend_t backend, ggml_abort_callback abort_callback, void * user_data);
 
 // helper to check if the device supports a specific family
diff --git a/ggml/src/ggml-metal/ggml-metal.cpp b/ggml/src/ggml-metal/ggml-metal.cpp
index aca83e1..3138c13 100644
--- a/ggml/src/ggml-metal/ggml-metal.cpp
+++ b/ggml/src/ggml-metal/ggml-metal.cpp
@@ -251,6 +251,11 @@ static bool ggml_backend_buffer_is_metal(ggml_backend_buffer_t buffer) {
            buffer->iface.free_buffer == ggml_backend_metal_buffer_private_free_buffer;
 }
 
+bool ggml_backend_metal_buffer_is_shared(ggml_backend_buffer_t buffer) {
+    return buffer != nullptr && ggml_backend_buffer_is_metal(buffer) &&
+           ggml_metal_buffer_is_shared((ggml_metal_buffer_t) buffer->context);
+}
